# Copy to $HERMES_HOME/.env; bash-compatible KEY=value, chmod 600.
MODEL_API_KEY=
TELEGRAM_BOT_TOKEN=
# Owner allowed to DM the assistant. Keep private data out of this shared instance.
TELEGRAM_ALLOWED_USERS=
# Target group only; keep the sign. Members of this group can query connected data.
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_GROUP_ALLOWED_CHATS=
# Digest recipient: group ID (signed) or a private user ID.
TWITTER_DIGEST_USER_ID=
# Positive user ID for failure DMs; must first send /start to the bot.
TWITTER_DIGEST_ERROR_USER_ID=
TWITTER_DIGEST_SCHEDULE='0 9 * * *'
TWITTER_DIGEST_TIMEZONE=UTC
# Optional, scope-limited, read-only credentials. Servers are disabled by default.
GITHUB_READ_ONLY_TOKEN=
LINEAR_READ_ONLY_TOKEN=
# Prefer secrets/apify.key for cron; environment fallback for manual runs.
APIFY_TOKEN=
# Optional ambient routing: enable only after disclosure and explicit configuration.
JEV_API_KEY=
